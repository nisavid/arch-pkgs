pkgname=python-posthog
pkgver=7.16.2
pkgrel=1
pkgdesc="Integrate PostHog into Python applications"
arch=('any')
url="https://pypi.org/project/posthog/"
license=('MIT')
depends=('python' 'python-backoff' 'python-distro' 'python-requests' 'python-typing_extensions')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/3e/f5/47118915e8ab01c141f7fbc4a882646de7fe2fb30d446f7c666dbbcf0847/posthog-${pkgver}.tar.gz")
sha256sums=('6411aaa3defa31fee43441b4d3284f2cda38652b0221a17b586769c29c913dac')

build() {
  cd "posthog-${pkgver}"
  python -m build --wheel --no-isolation
}

package() {
  cd "posthog-${pkgver}"
  python -m installer --destdir="$pkgdir" --no-compile-bytecode dist/*.whl
}
