pkgname=python-posthog
pkgver=7.19.2
pkgrel=1
pkgdesc="Integrate PostHog into Python applications"
arch=('any')
url="https://pypi.org/project/posthog/"
license=('MIT')
depends=('python' 'python-backoff' 'python-distro' 'python-requests' 'python-typing_extensions')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/19/24/c4880740bb875c05da8cb4cb70fcb4d0e572748bae30347f73de97217851/posthog-${pkgver}.tar.gz")
sha256sums=('c39d464b5b5930bf930329ba2593a778d44ecf8724f2c3b473209e3e68ef6cad')

build() {
  cd "posthog-${pkgver}"
  python -m build --wheel --no-isolation
}

package() {
  cd "posthog-${pkgver}"
  python -m installer --destdir="$pkgdir" --no-compile-bytecode dist/*.whl
}
