# Bind automatically generated URL/YouTube collections to their authenticated owner.
# Open WebUI commit: 8bd8b4fac5e059578ac0c74b3c18d11139f88b7d
# Open WebUI 0.11.4 sdist SHA-256: 1f1a31668a0dee733953c29d6183d78dd78984e696aa8eb0f2083f5796497be0
# Apply after 0001-0009 and 0011; leave pristine evidence fixtures unchanged.
diff --git a/backend/open_webui/retrieval/utils.py b/backend/open_webui/retrieval/utils.py
--- a/backend/open_webui/retrieval/utils.py
+++ b/backend/open_webui/retrieval/utils.py
@@ -1309,6 +1309,18 @@
         return predict
 
 
+def _url_collection_owner_prefix(user_id: str) -> str:
+    # Fixed-width owner scope: never truncate the caller's identity to fit a name.
+    owner = hashlib.sha256(user_id.encode()).hexdigest()[:32]
+    return f'url-{owner}-'
+
+
+def get_url_collection_name(user_id: str, url: str) -> str:
+    # 63 characters for vector backends with a collection-name length limit.
+    digest = hashlib.sha256(url.encode()).hexdigest()[:26]
+    return f'{_url_collection_owner_prefix(user_id)}{digest}'
+
+
 # UUIDs, SHA-256 digests, and prefixed variants thereof all fit [A-Za-z0-9_-].
 # Anything else cannot be a real Open WebUI collection and could break out of
 # a Milvus expression literal.
@@ -1331,6 +1343,7 @@
       - any name with characters outside [A-Za-z0-9_-] → rejected
       - file-*          → validated via has_access_to_file
       - user-memory-*   → must match user's own memory collection
+      - url-*           → generated URL collections, bound to the authenticated owner
       - web-search-*    → ephemeral per-query collections, owner-bound to web-search-{user.id}-*
       - knowledge-bases → always denied (system meta-collection)
       - everything else → if the name matches a knowledge base, validated
@@ -1364,6 +1377,14 @@
                 validated.add(name)
         elif name.startswith('user-memory-'):
             if name == f'user-memory-{user.id}':
+                validated.add(name)
+        elif re.match(r'[-_]*url[-_]', name, re.IGNORECASE):
+            # Reserve aliases too: Milvus replaces hyphens with underscores;
+            # Weaviate also strips edge underscores and capitalizes the name.
+            if (
+                re.fullmatch(r'url-[0-9a-f]{32}-[0-9a-f]{26}', name)
+                and name.startswith(_url_collection_owner_prefix(user.id))
+            ):
                 validated.add(name)
         elif name.startswith('web-search-'):
             # Ephemeral per-query collections, owner-bound: process_web_search mints
