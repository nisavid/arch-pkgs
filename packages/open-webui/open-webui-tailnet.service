[Unit]
Description=Tailnet route for Open WebUI (unprivileged userspace tailscaled)
Documentation=https://tailscale.com/kb/1112/userspace-networking
After=network-online.target
Wants=network-online.target

# A second tailscaled instance, separate from any system tailscaled.service.
# It runs without root or TUN; its node name, login, and serve configuration
# are runtime state set by the operator (see the package README). Log uploads
# to Tailscale are off unless the operator opts in with a drop-in.

[Service]
Type=notify
DynamicUser=yes
SupplementaryGroups=open-webui-proxy
StateDirectory=open-webui-tailnet
StateDirectoryMode=0700
RuntimeDirectory=open-webui-tailnet
RuntimeDirectoryMode=0750
Environment=TS_NO_LOGS_NO_SUPPORT=true
ExecStart=/usr/bin/tailscaled --statedir=%S/open-webui-tailnet --socket=%t/open-webui-tailnet/tailscaled.sock --tun=userspace-networking --port=0
Restart=on-failure
RestartSec=5s
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# In userspace-networking mode, tailscaled forwards a tailnet connection on any
# port it does not serve to that port on the host's loopback. Deny that path so
# the serve route is the only way in.
IPAddressDeny=127.0.0.1 ::1
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
