prepare() {
  cd "${_source_root}"

  python "${srcdir}/verify-open-webui-private-lock.py" \
    uv.lock \
    "${srcdir}/open-webui-private-constraints.txt" \
    "${srcdir}/open-webui-system-providers.txt" \
    "${srcdir}/open-webui-private-requirements.lock"

  local _python_closure="${srcdir}/open-webui-python-offline-closure-${pkgver}-cp314-x86_64.tar.zst"
  python "${srcdir}/python-offline-closure.py" verify-archive \
    --lock "${srcdir}/open-webui-private-requirements.lock" \
    --archive "${_python_closure}"
  rm -rf "${srcdir}/open-webui-python-offline-closure"
  bsdtar -xf "${_python_closure}" -C "${srcdir}"

  rm -rf "${srcdir}/npm-cache"
  python "${srcdir}/npm-offline-closure.py" seed \
    --lock package-lock.json \
    --manifest "${srcdir}/npm-offline-closure-manifest.json" \
    --archive "${srcdir}/open-webui-npm-offline-closure-${pkgver}.tar.zst" \
    --npm-cache "${srcdir}/npm-cache"

  patch --fuzz=0 -Np1 -i "${srcdir}/0001-support-python-3.14.patch"
  patch --fuzz=0 -Np1 -i "${srcdir}/0002-use-system-ml-stack.patch"
  patch --fuzz=0 -Np1 -i "${srcdir}/0003-build-frozen-frontend.patch"
  patch --fuzz=0 -Np1 -i "${srcdir}/0004-support-unix-socket.patch"
  install -Dm644 "${srcdir}/open-webui-rag-gate.py" \
    backend/open_webui/retrieval/rag_gate.py
  patch --fuzz=0 -Np1 -i "${srcdir}/0005-require-qualified-reranking.patch"
  patch --fuzz=0 -d backend -Np1 -i "${srcdir}/0006-enforce-session-epoch.patch"
  patch --fuzz=0 -Np1 -i "${srcdir}/0007-keep-rag-credentials-external.patch"

  local _seed="${srcdir}/open-webui-pyodide-${pkgver}"
  rm -rf "${_seed}"
  install -d "${_seed}"
  bsdtar -xf "${srcdir}/open_webui-${pkgver}-py3-none-any.whl" \
    -C "${_seed}" 'open_webui/frontend/pyodide/*'

  local _pyodide="${_seed}/open_webui/frontend/pyodide"
  local _count _bytes _manifest
  _count=$(find "${_pyodide}" -type f -printf '%P\n' | wc -l)
  _bytes=$(find "${_pyodide}" -type f -printf '%s\n' | awk '{ total += $1 } END { print total }')
  _manifest=$(
    cd "${_pyodide}"
    find . -type f -printf '%P\0' | LC_ALL=C sort -z | while IFS= read -r -d '' _file; do
      sha256sum "${_file}"
    done | sha256sum | awk '{ print $1 }'
  )
  [[ ${_count} == 60 ]]
  [[ ${_bytes} == 59832549 ]]
  [[ ${_manifest} == "${_pyodide_manifest_sha256}" ]]

  rm -rf static/pyodide
  cp -a "${_pyodide}" static/pyodide
}

build() {
  cd "${_source_root}"

  unset -f module ml 2>/dev/null || true
  unset 'BASH_FUNC_module%%' 'BASH_FUNC_ml%%' 2>/dev/null || true
  export APP_BUILD_HASH="v${pkgver}"
  export CCACHE_DISABLE=1
  export CYPRESS_CACHE_FOLDER="${srcdir}/cypress-cache"
  export CYPRESS_INSTALL_BINARY=0
  export NODE_OPTIONS="--max_old_space_size=4096"
  export HOME="${srcdir}/build-home"
  export NPM_CONFIG_CACHE="${srcdir}/npm-cache"
  export NPM_CONFIG_OFFLINE=true
  export NPM_CONFIG_UPDATE_NOTIFIER=false
  export ONNXRUNTIME_NODE_INSTALL_CUDA=skip
  export SHARP_IGNORE_GLOBAL_LIBVIPS=1
  export UV_CACHE_DIR="${srcdir}/uv-cache"
  export UV_PYTHON_INSTALL_DIR="${srcdir}/uv-python"
  install -d "${HOME}" "${NPM_CONFIG_CACHE}"
  python -m build --wheel --no-isolation
}

package() {
  cd "${_source_root}"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 LICENSE_HISTORY "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE_HISTORY"
  install -Dm644 LICENSE_NOTICE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE_NOTICE"

  install -Dm755 "${srcdir}/open-webui-wrapper" "${pkgdir}/usr/bin/open-webui"
  install -Dm755 "${srcdir}/open-webui-commission-admin" \
    "${pkgdir}/usr/lib/open-webui/open-webui-commission-admin"
  install -Dm755 "${srcdir}/open-webui-session-epoch-ledger.py" \
    "${pkgdir}/usr/lib/open-webui/open-webui-session-epoch-ledger"
  install -Dm600 "${srcdir}/open-webui.env" "${pkgdir}/etc/open-webui/open-webui.env"
  install -Dm644 "${srcdir}/open-webui.service" \
    "${pkgdir}/usr/lib/systemd/system/open-webui.service"
  install -Dm644 "${srcdir}/open-webui.sysusers" \
    "${pkgdir}/usr/lib/sysusers.d/open-webui.conf"
  install -Dm644 "${srcdir}/open-webui.tmpfiles" \
    "${pkgdir}/usr/lib/tmpfiles.d/open-webui.conf"

  local _site="${pkgdir}/opt/open-webui/lib/python${_pyver}/site-packages"
  install -d "${_site}"
  CCACHE_DISABLE=1 \
    UV_CACHE_DIR="${srcdir}/uv-cache" \
    UV_PYTHON_INSTALL_DIR="${srcdir}/uv-python" \
    UV_LINK_MODE=copy \
    uv pip install \
      --python /usr/bin/python \
      --target "${_site}" \
      --offline \
      --no-index \
      --find-links "${srcdir}/open-webui-python-offline-closure/wheelhouse" \
      --require-hashes \
      --no-deps \
      -r "${srcdir}/open-webui-private-requirements.lock"
  CCACHE_DISABLE=1 \
    UV_CACHE_DIR="${srcdir}/uv-cache" \
    UV_PYTHON_INSTALL_DIR="${srcdir}/uv-python" \
    UV_LINK_MODE=copy \
    uv pip install \
      --python /usr/bin/python \
      --target "${_site}" \
      --offline \
      --no-index \
      --no-deps \
      "dist/open_webui-${pkgver}-py3-none-any.whl"

  rm -f "${_site}/open_webui-${pkgver}.dist-info/direct_url.json"
  if [[ -d "${_site}/bin" ]]; then
    find "${_site}/bin" -type f \
      -exec sed -i '1s|^#!.*/\.venv/bin/python3$|#!/usr/bin/python|' {} +
  fi
  install -Dm644 package.json \
    "${pkgdir}/opt/open-webui/lib/python${_pyver}/package.json"
  install -Dm644 package.json "${_site}/open_webui/package.json"

  python "${srcdir}/verify-open-webui-provider-boundary.py" "${_site}"
}
