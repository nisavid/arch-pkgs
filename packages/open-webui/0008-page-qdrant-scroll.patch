# Page Qdrant scroll reads so strict-mode max_query_limit does not reject them.
# Open WebUI commit: 8bd8b4fac5e059578ac0c74b3c18d11139f88b7d
# Open WebUI 0.11.4 sdist SHA-256: 1f1a31668a0dee733953c29d6183d78dd78984e696aa8eb0f2083f5796497be0
# Apply after 0001-0007; none of them touch these files.
# query() and get() in both Qdrant clients follow next_page_offset instead of
# one scroll with NO_LIMIT = 999999999. Each request asks for at most
# SCROLL_PAGE_SIZE = 1000 points. Paging stops when Qdrant returns no next
# offset or a positive caller limit is reached; the last request asks only for
# the remaining count. As guards, it also stops on an empty page or on the
# offset it was just sent, logs a warning, and keeps the points already read.
# A caller limit of 0 or less makes query() return an empty result after the
# existing collection check, without a scroll request (upstream sent the limit
# to Qdrant, which rejects limit=0); a missing collection still returns None.
# A paged read is not a point-in-time snapshot; concurrent writes may or
# may not appear, while every point present for the whole read is returned
# exactly once.
# SCROLL_PAGE_SIZE must stay at or below the packaged Qdrant strict-mode
# max_query_limit (1000, packages/qdrant/qdrant.config.yaml).
# search() top-k is unchanged. In the non-multitenancy client, search(limit=None)
# still maps to NO_LIMIT; the household runs multitenancy mode and does not use it.
# Drop this patch only once an upstream Open WebUI release pages Qdrant
# scroll reads with requests at or below the packaged Qdrant max_query_limit
# (1000), and only after checking a strict-mode read of more than 1,000 points
# against that release.
# Details: packages/open-webui/README.md, Qdrant Scroll Paging
diff --git a/backend/open_webui/retrieval/vector/dbs/qdrant.py b/backend/open_webui/retrieval/vector/dbs/qdrant.py
index f8ed600..c10c10e 100644
--- a/backend/open_webui/retrieval/vector/dbs/qdrant.py
+++ b/backend/open_webui/retrieval/vector/dbs/qdrant.py
@@ -31,6 +31,36 @@ NO_LIMIT = 999999999
 
 log = logging.getLogger(__name__)
 
+# Qdrant's scroll API is paginated. Read in bounded pages and follow
+# next_page_offset instead of requesting everything at once, which a
+# strict-mode max_query_limit rejects.
+SCROLL_PAGE_SIZE = 1000
+
+
+def _scroll_all(client, collection_name: str, scroll_filter=None, limit: int | None = None) -> list:
+    points, offset = [], None
+    while limit is None or len(points) < limit:
+        page_size = SCROLL_PAGE_SIZE if limit is None else min(SCROLL_PAGE_SIZE, limit - len(points))
+        prev = offset
+        page, offset = client.scroll(
+            collection_name=collection_name,
+            scroll_filter=scroll_filter,
+            limit=page_size,
+            offset=offset,
+        )
+        points.extend(page)
+        if offset is None or (limit is not None and len(points) >= limit):
+            break
+        if not page or offset == prev:
+            log.warning(
+                'Stopped scrolling Qdrant collection %s on an unexpected %s; returning the %d points read so far',
+                collection_name,
+                'empty page' if not page else 'repeated offset',
+                len(points),
+            )
+            break
+    return points
+
 
