# See: https://docs.openwebui.com/getting-started/env-configuration

OPEN_WEBUI_HOST=127.0.0.1
OPEN_WEBUI_PORT=8080

ENV=prod
FROM_INIT_PY=true
FRONTEND_BUILD_DIR=/opt/open-webui/lib/python3.14/site-packages/open_webui/frontend
DATA_DIR=/var/lib/open-webui/data
CACHE_DIR=/var/lib/open-webui/cache
HF_HOME=/var/lib/open-webui/cache/huggingface
SENTENCE_TRANSFORMERS_HOME=/var/lib/open-webui/cache/embedding/models
TIKTOKEN_CACHE_DIR=/var/lib/open-webui/cache/tiktoken
WHISPER_MODEL_DIR=/var/lib/open-webui/cache/whisper/models

OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
