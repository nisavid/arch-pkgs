pkgname=qdrant
pkgver=1.19.1
pkgrel=1
_cargo_sbom_ver=0.10.0
_qdrant_source_sha256=ca9f0cb5a6954d253b51f249161cb63e2c3fee2a3bf360056cf01f0e70b2b878
_source_date_epoch=1788438978
pkgdesc="Vector Database for the next generation of AI applications"
arch=('x86_64')
url="https://qdrant.tech"
license=('Apache-2.0')
depends=('bash' 'coreutils' 'gcc-libs' 'glibc' 'qdrant-web-ui')
makedepends=('cargo' 'cmake' 'mold' 'clang' 'jq' 'protobuf')
options=('!debug' '!lto')
backup=('etc/qdrant/config.yaml')
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/qdrant/qdrant/archive/v${pkgver}.tar.gz"
  "cargo-sbom-${_cargo_sbom_ver}.tar.gz::https://static.crates.io/crates/cargo-sbom/cargo-sbom-${_cargo_sbom_ver}.crate"
  'qdrant.config.yaml'
  'qdrant.service'
  'qdrant.sysusers'
  'qdrant.tmpfiles'
  'qdrant-secret-preflight'
  'qdrant-web-ui-headers.patch'
)
sha256sums=("${_qdrant_source_sha256}"
            '4ffe4b49660f4f4331fb5efcf7074a318b10f5f8fd75e42351a7ca32c58c2723'
            '800fd7130542e5d61bc869962e6d7d59de2bccad261811d54e9b6745ffc991f4'
            '610312cbba4efffa1d5422ab75154605000d4a4d177f77437ca00e2926ef4114'
            '963c4954011a2b074d265f51e292289e004876be80228f60b0b9f2d98151d143'
            '4758bc1b0cd16a83e08ca74d72b0d1079d7ae46085379fe0ea5b134e984c1698'
            '6a364ce0a745c6f02d38f3c39fc71e91fd31a2f33e63442cfa64b251fab545cd'
            '0c857555633a209b054d0077e88ecbdced9e648a35a375bb93457af8ccee4770')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  patch -Np1 -i "${srcdir}/qdrant-web-ui-headers.patch"
  cargo fetch --locked
  cargo fetch --locked \
    --manifest-path "${srcdir}/cargo-sbom-${_cargo_sbom_ver}/Cargo.toml"
}

_without_native_arch_flags() {
  local flag
  local -a filtered=()
  local -a inherited=()

  read -r -a inherited <<<"$1"
  for flag in "${inherited[@]}"; do
    case "$flag" in
      -march=*|-mcpu=*|-mtune=*) ;;
      *) filtered+=("$flag") ;;
    esac
  done

  printf '%s' "${filtered[*]}"
}

build() {
  local cargo_home="${CARGO_HOME:-${HOME}/.cargo}"
  local sbom_created
  local sbom_namespace

  sbom_created="$(date -u --date="@${_source_date_epoch}" +%Y-%m-%dT%H:%M:%SZ)"
  sbom_namespace="https://spdx.org/spdxdocs/qdrant-${pkgver}-${_qdrant_source_sha256}"

  cargo build --release --locked \
    --manifest-path "${srcdir}/cargo-sbom-${_cargo_sbom_ver}/Cargo.toml" \
    --target-dir "${srcdir}/cargo-sbom-target"

  cd "${srcdir}/${pkgname}-${pkgver}"
  # note: (GCC +) mold or (Clang +) lld are required to build with LTO
  # aws-lc-sys preserves Arch optimization flags from CFLAGS, but its bundled
  # jitter entropy code rejects optimized builds unless explicitly disabled.
  export CCACHE_DISABLE=1
  export AWS_LC_SYS_NO_JITTER_ENTROPY=1
  # Keep upstream's Rust fat LTO, but do not feed makepkg's GCC LTO objects
  # into it: GCC's LTO serialization is not root-independent. Native source
  # paths are still remapped for macros and any retained diagnostics. Qdrant's
  # native build scripts select explicit SIMD flags per source file; inherited
  # architecture and tuning selectors must not override those later in the
  # compiler command.
  export CFLAGS="$(_without_native_arch_flags "${CFLAGS}") -ffile-prefix-map=${srcdir}=/usr/src/debug/${pkgname} -ffile-prefix-map=${cargo_home}=/usr/src/debug/cargo -fdebug-prefix-map=${srcdir}=/usr/src/debug/${pkgname} -fdebug-prefix-map=${cargo_home}=/usr/src/debug/cargo -fmacro-prefix-map=${srcdir}=/usr/src/debug/${pkgname} -fmacro-prefix-map=${cargo_home}=/usr/src/debug/cargo"
  export CXXFLAGS="$(_without_native_arch_flags "${CXXFLAGS}") -ffile-prefix-map=${srcdir}=/usr/src/debug/${pkgname} -ffile-prefix-map=${cargo_home}=/usr/src/debug/cargo -fdebug-prefix-map=${srcdir}=/usr/src/debug/${pkgname} -fdebug-prefix-map=${cargo_home}=/usr/src/debug/cargo -fmacro-prefix-map=${srcdir}=/usr/src/debug/${pkgname} -fmacro-prefix-map=${cargo_home}=/usr/src/debug/cargo"
  export RUSTFLAGS="${RUSTFLAGS} --remap-path-prefix=${srcdir}=/usr/src/debug/${pkgname} --remap-path-prefix=${cargo_home}=/usr/src/debug/cargo -Clink-arg=-fuse-ld=mold"
  # export CC=clang CXX=clang++ RUSTFLAGS="${RUSTFLAGS} -Clink-arg=-fuse-ld=lld"
  export CXXFLAGS="$CXXFLAGS -include cstdint"
  cargo build --release --locked --bin qdrant

  CARGO_NET_OFFLINE=true \
    "${srcdir}/cargo-sbom-target/release/cargo-sbom" \
    --cargo-package qdrant \
    --project-directory "${srcdir}/${pkgname}-${pkgver}" \
    > qdrant.spdx.json
  jq -S --arg created "${sbom_created}" \
    --arg namespace "${sbom_namespace}" '
      .creationInfo.created = $created |
      .documentNamespace = $namespace |
      .files |= sort_by(.SPDXID) |
      .packages |= sort_by(.SPDXID) |
      .relationships |= sort_by(.spdxElementId, .relationshipType, .relatedSpdxElement)
    ' qdrant.spdx.json > qdrant.spdx.json.tmp
  mv qdrant.spdx.json.tmp qdrant.spdx.json
  jq -e --arg created "${sbom_created}" \
    --arg namespace "${sbom_namespace}" \
    --arg version "${pkgver}" \
    --arg generator "Tool: cargo-sbom-v${_cargo_sbom_ver}" '
      .spdxVersion == "SPDX-2.3" and
      .dataLicense == "CC0-1.0" and
      .creationInfo.created == $created and
      .documentNamespace == $namespace and
      any(.creationInfo.creators[]; . == $generator) and
      any(.packages[]; .name == "qdrant" and .versionInfo == $version) and
      (.relationships | length > 0)
    ' qdrant.spdx.json >/dev/null
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 "target/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 "${srcdir}/qdrant.config.yaml" "${pkgdir}/etc/qdrant/config.yaml"
  install -Dm644 "${srcdir}/qdrant.service" "${pkgdir}/usr/lib/systemd/system/qdrant.service"
  install -Dm644 "${srcdir}/qdrant.sysusers" "${pkgdir}/usr/lib/sysusers.d/qdrant.conf"
  install -Dm644 "${srcdir}/qdrant.tmpfiles" "${pkgdir}/usr/lib/tmpfiles.d/qdrant.conf"
  install -Dm755 "${srcdir}/qdrant-secret-preflight" \
    "${pkgdir}/usr/lib/qdrant/qdrant-secret-preflight"
  install -Dm644 qdrant.spdx.json \
    "${pkgdir}/usr/share/qdrant/qdrant.spdx.json"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
