#!/usr/bin/bash

set -euo pipefail
export LC_ALL=C

fail() {
  printf 'qdrant secret preflight: %s\n' "$1" >&2
  exit 1
}

(( $# == 1 )) || fail 'expected exactly one secret-file path'

readonly secret_file="$1"

[[ ! -L "$secret_file" ]] || fail 'secret file must not be a symlink'
[[ -f "$secret_file" ]] || fail 'secret file must be a regular file'

metadata="$(stat --format '%u:%g:%a' -- "$secret_file")" \
  || fail 'could not inspect secret file metadata'
effective_gid="$(id -g)" || fail 'could not determine the service effective group'
IFS=: read -r owner_uid owner_gid mode <<<"$metadata"

[[ "$owner_uid" == 0 ]] || fail 'secret file must be owned by root (UID 0)'
[[ "$owner_gid" == "$effective_gid" ]] \
  || fail 'secret file group must match the service effective group'
[[ "$mode" == 640 ]] || fail 'secret file mode must be exactly 0640'

mapfile -t lines <"$secret_file" || fail 'could not read secret file'
(( ${#lines[@]} == 1 )) \
  || fail 'secret file must contain exactly one QDRANT__SERVICE__API_KEY line'
[[ "${lines[0]}" =~ ^QDRANT__SERVICE__API_KEY=[0-9a-f]{64,}$ ]] \
  || fail 'QDRANT__SERVICE__API_KEY must be at least 64 lowercase hexadecimal characters'
