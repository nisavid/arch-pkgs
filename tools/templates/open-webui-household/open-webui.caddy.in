# Open WebUI household route: Caddy terminates HTTPS and proxies to the
# Open WebUI UNIX socket. Rendered by tools/open_webui_household_scenarios.py.
# The acceptance render adds the global options (admin off, no :80 redirect,
# no trust-store install, loopback default bind, storage under the root);
# the production render installs only the site block under /etc/caddy/conf.d.
@GLOBAL_OPTIONS@
@SITE_ADDRESS@ {
	bind @BIND@
	tls @TLS@
	reverse_proxy unix/@SOCKET@
}
