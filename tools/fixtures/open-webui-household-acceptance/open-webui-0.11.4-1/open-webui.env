# Stable non-secret defaults for the packaged Open WebUI service boundary.
# Secrets are mandatory systemd credentials loaded by open-webui-wrapper.
# Host-specific settings, such as the model provider, belong in the host-owned
# /etc/open-webui/household.env, which open-webui.service reads after this
# file; /usr/share/open-webui/household.env.example documents each key.

ENV=prod
FROM_INIT_PY=true
UVICORN_WORKERS=1
FRONTEND_BUILD_DIR=/opt/open-webui/lib/python3.14/site-packages/open_webui/frontend
STATIC_DIR=/var/lib/open-webui/static
DATA_DIR=/var/lib/open-webui/data
DATABASE_URL=sqlite:////var/lib/open-webui/data/webui.db
CACHE_DIR=/var/lib/open-webui/cache
HF_HOME=/var/lib/open-webui/cache/huggingface
SENTENCE_TRANSFORMERS_HOME=/var/lib/open-webui/cache/embedding/models
TIKTOKEN_CACHE_DIR=/var/lib/open-webui/cache/tiktoken
WHISPER_MODEL_DIR=/var/lib/open-webui/cache/whisper/models

WEBUI_AUTH=true
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending
ENABLE_API_KEYS=false
ENABLE_PERSISTENT_CONFIG=true
WEBUI_SESSION_COOKIE_SECURE=true
WEBUI_SESSION_COOKIE_SAME_SITE=strict
WEBUI_AUTH_COOKIE_SECURE=true
WEBUI_AUTH_COOKIE_SAME_SITE=strict
BYPASS_ADMIN_ACCESS_CONTROL=false
BYPASS_MODEL_ACCESS_CONTROL=false
BYPASS_RETRIEVAL_ACCESS_CONTROL=false

ENABLE_PLUGINS=false
ENABLE_PIP_INSTALL_FRONTMATTER_REQUIREMENTS=false
ENABLE_DIRECT_CONNECTIONS=false
ENABLE_OPENAI_API_PASSTHROUGH=false
ENABLE_FORWARD_USER_INFO_HEADERS=false
ENABLE_VERSION_UPDATE_CHECK=false
OFFLINE_MODE=true
ENABLE_PROFILE_IMAGE_URL_FORWARDING=false
ENABLE_CODE_EXECUTION=false
ENABLE_CODE_INTERPRETER=false
USER_PERMISSIONS_FEATURES_CODE_INTERPRETER=false
ENABLE_AUTOMATIONS=false
USER_PERMISSIONS_FEATURES_AUTOMATIONS=false

# No default model peer: neither Ollama nor api.openai.com. A host profile
# enables the connection it needs.
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=false

VECTOR_DB=qdrant
QDRANT_URI=http://127.0.0.1:6333
QDRANT_ON_DISK=false
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION_PREFIX=open-webui-rag-v1
ENABLE_QDRANT_MULTITENANCY_MODE=true

# The RAG gate (0005) qualifies only an external reranker, refuses non-hybrid
# document retrieval, and refuses a reranker without a finite positive
# timeout. Document RAG stays closed until a host profile names the embedding
# provider and the reranker model and URL.
RAG_RERANKING_ENGINE=external
ENABLE_RAG_HYBRID_SEARCH=true
RAG_EXTERNAL_RERANKER_TIMEOUT=30

REDIS_KEY_PREFIX=open-webui-rag-v1
ENABLE_STAR_SESSIONS_MIDDLEWARE=true
WEBSOCKET_MANAGER=redis
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
